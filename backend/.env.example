# ============= Application Settings =============
APP_NAME="Fashion Try-On Backend"
APP_VERSION="1.0.0"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# ============= File Storage =============
UPLOAD_DIR="uploads"
RESULT_DIR="results"
MAX_FILE_SIZE=10485760  # 10MB in bytes

# ============= Database =============
DATABASE_URL="sqlite:///./fashion_tryon.db"

# ============= PHƯƠNG ÁN 1: ON-PREMISE MODEL =============
USE_ON_PREMISE=True
MODEL_TYPE="idm-vton"  # Options: idm-vton, ootdiffusion, outfitanyone
MODEL_PATH="./models"
DEVICE="cuda"  # cuda or cpu

# IDM-VTON Settings
IDM_VTON_CHECKPOINT="./models/idm-vton"
IDM_VTON_DENOISE_STEPS=30
IDM_VTON_SEED=42

# OOTDiffusion Settings
OOTD_CHECKPOINT="./models/ootdiffusion"
OOTD_MODEL_TYPE="hd"
OOTD_CATEGORY="upperbody"

# ============= PHƯƠNG ÁN 2: EXTERNAL API =============
USE_EXTERNAL_API=True
API_PROVIDER="replicate"  # Options: replicate, fal, heybeauty

# HeyBeauty API
# Get your API keys from: https://heybeauty.ai/keys
HEYBEAUTY_API_URL=""
HEYBEAUTY_OPEN_ID=""
HEYBEAUTY_API_KEY=""
HEYBEAUTY_OSS_URL=""

# Replicate API
# Get your token from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=""
REPLICATE_MODEL="cuuupid/idm-vton:c871bb9b046607b680449ecbae55fd8c6d945e0a1948644bf2361b3d021d3ff4"

# Fal.ai API
# Get your key from: https://fal.ai/dashboard/keys
FAL_API_KEY=""
FAL_MODEL="fal-ai/idm-vton"

# API Timeout Settings
API_TIMEOUT=300
API_MAX_RETRIES=3
